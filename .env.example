# ==============================================================================
# CYBERSHIELD SUPABASE & ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (frontend/.env)
# ------------------------------------------------------------------------------
# Get these from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Google OAuth Client ID for native Google Identity button
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 2. BACKEND DATABASE (Supabase Managed PostgreSQL)
# ------------------------------------------------------------------------------
# Get this from Supabase Dashboard: Project Settings -> Database -> Connection string (URI)
# Mode: Transaction pooler (Port 6543) or Direct (Port 5432)
SUPABASE_DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-database-password

# Or standard DATABASE_URL format:
DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-database-password

# Active Spring Profile for Supabase
SPRING_PROFILES_ACTIVE=supabase
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
PORT=8080
